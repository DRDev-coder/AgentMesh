# Runtime
APP_ENV=development
SAAS_ENABLED=true
API_PORT=8000
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL + Redis. Docker Compose injects its internal service URLs.
DATABASE_URL=postgresql+psycopg://agentmesh:agentmesh@localhost:5432/agentmesh
REDIS_URL=redis://localhost:6379/0

# Supabase Auth. Use development mode locally; staging/production must use Supabase.
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=

# Private object storage. Docker Compose supplies local MinIO values.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_PATH=state/documents
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=agentmesh-documents
S3_ACCESS_KEY_ID=agentmesh-local
S3_SECRET_ACCESS_KEY=agentmesh-local-secret
DOCUMENT_MAX_BYTES=26214400
MALWARE_SCAN_URL=
MALWARE_SCAN_API_KEY=

# Server-only security secrets. Replace these outside isolated local development.
API_KEY_PEPPER=development-only-agentmesh-pepper
WEBHOOK_ENCRYPTION_KEY=development-webhook-key
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Usage and billing. Prices/cost limits are deployment inputs, never source constants.
FREE_DECISIONS_PER_MONTH=500
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_METER_EVENT_NAME=agentmesh_decisions
OVERAGE_UNIT_PRICE_CENTS=0
PROVIDER_COST_CAP_CENTS=0
ESTIMATED_COST_PER_DECISION_MILLICENTS=0

# Transactional email adapter.
EMAIL_PROVIDER_URL=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=AgentMesh <noreply@example.local>

# AgentMesh-owned model provider. Empty keeps the deterministic local test path.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
AGENT_TIMEOUT_SECONDS=15

# Worker behavior. Docker/hosted environments should keep this false.
TASKS_EAGER=true

# Temporary compatibility route settings; not part of the public SaaS API.
KNOWLEDGE_BASE_PATH=data/product_docs.json
DATABASE_PATH=state/agentmesh.db
RETRIEVAL_MIN_SCORE=0.18
QUERY_MAX_LENGTH=4000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Experimental module is deliberately outside the SaaS request path.
BLOCKCHAIN_ENABLED=false

# Frontend (place these in frontend/.env.local for Vite).
VITE_API_URL=http://localhost:8000/api/v1