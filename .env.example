# Optional hosted model. Leave GROQ_API_KEY empty to use the local deterministic path.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Backend data and policy configuration.
API_PORT=8000
KNOWLEDGE_BASE_PATH=data/product_docs.json
RETRIEVAL_MIN_SCORE=0.18
DATABASE_PATH=state/agentmesh.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
QUERY_MAX_LENGTH=4000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
AGENT_TIMEOUT_SECONDS=15

# Optional blockchain audit anchor. SQLite remains the primary audit store.
BLOCKCHAIN_ENABLED=false
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_WALLET_ADDRESS=
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_EXPLORER_URL=
BLOCKCHAIN_NETWORK=local
BLOCKCHAIN_RECEIPT_TIMEOUT=30

# Frontend API base. Put this value in frontend/.env.local for local Vite usage.
VITE_API_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT_MS=90000
VITE_BLOCK_EXPLORER_TX_URL=

# Protects prototype human-review endpoints. Replace before any shared deployment.
REVIEW_API_KEY=replace-with-a-long-random-value
