# Runtime
APP_ENV=development
SAAS_ENABLED=true
API_PORT=8000
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL + Redis. Docker Compose injects its internal service URLs.
DATABASE_URL=postgresql+psycopg://agentmesh:agentmesh@localhost:5432/agentmesh
REDIS_URL=redis://localhost:6379/0

# Supabase Auth. Use development mode locally; staging/production must use Supabase.
AUTH_MODE=development
SUPABASE_URL=
SUPABASE_JWT_AUDIENCE=authenticated
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_OAUTH_ENABLED=false
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=


# Private object storage. Docker Compose supplies local MinIO values. Async
# staging/production workers require s3 or azure_blob because container-local
# paths are not shared. Local storage is only safe for single-process eager use.
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_PATH=state/documents
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=agentmesh-documents
S3_ACCESS_KEY_ID=agentmesh-local
S3_SECRET_ACCESS_KEY=agentmesh-local-secret
# Azure-native alternative to S3. In Azure, prefer managed identity and leave
# AZURE_STORAGE_CONNECTION_STRING empty.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=agentmesh-documents
DOCUMENT_MAX_BYTES=26214400
MALWARE_SCAN_URL=
MALWARE_SCAN_API_KEY=

# Server-only security secrets. Replace these outside isolated local development.
API_KEY_PEPPER=development-only-agentmesh-pepper
WEBHOOK_ENCRYPTION_KEY=development-webhook-key
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Usage and Razorpay billing. Monetary customer limits are in Indian paise.
FREE_DECISIONS_PER_MONTH=500
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Explicit local/staging fallback. Never enable this in production.
RAZORPAY_DEMO_MODE=false
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_SUBSCRIPTION_TOTAL_COUNT=120
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
OVERAGE_UNIT_PRICE_PAISE=0
PROVIDER_COST_CAP_CENTS=0
ESTIMATED_COST_PER_DECISION_MILLICENTS=0
# Razorpay Payment Gateway (Test Mode)

# Resend transactional email. Put the real key only in ignored .env files.
RESEND_API_KEY=
RESEND_FROM=AgentMesh <onboarding@resend.dev>

# AgentMesh-owned model provider. Empty keeps the deterministic local test path.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
AGENT_TIMEOUT_SECONDS=15

# Worker behavior. Docker/hosted environments should keep this false and use
# shared object storage. TASKS_EAGER=true is only a temporary staging workaround.
TASKS_EAGER=true

# Temporary compatibility route settings; not part of the public SaaS API.
KNOWLEDGE_BASE_PATH=data/product_docs.json
DATABASE_PATH=state/agentmesh.db
RETRIEVAL_MIN_SCORE=0.18
QUERY_MAX_LENGTH=4000
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# Experimental module is deliberately outside the SaaS request path.
BLOCKCHAIN_ENABLED=false

# Frontend (place these in frontend/.env.local for Vite).
VITE_API_URL=http://localhost:8000
